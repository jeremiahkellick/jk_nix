+// onTitle refreshes a tracked window's cached title without touching MRU
+// order, since unlike onFocus this fires on every keystroke that changes a
+// title (e.g. shell prompts that show the running command), not just on
+// actual focus changes.
+func (d *Daemon) onTitle(con *ipc.Container) {
+	id := strconv.Itoa(con.ID)
+	data, ok := d.winData[id]
+	if !ok {
+		return
+	}
+
+	data.Title = con.Name
+	d.winData[id] = data
+}
